{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "go fmt ./... && golangci-lint run ./...",
            "statusMessage": "Formatting and linting..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "go fmt ./... && golangci-lint run ./...",
            "statusMessage": "Formatting and linting new file..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/test-before-commit.sh\"",
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
