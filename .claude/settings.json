{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "go fmt ./... && golangci-lint run ./...",
            "statusMessage": "Formatting and linting..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "go fmt ./... && golangci-lint run ./...",
            "statusMessage": "Formatting and linting new file..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "go test ./...",
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}